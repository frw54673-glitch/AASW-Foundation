# ─────────────────────────────────────────────────────────────────────────────
# AASW Foundation — environment template
# Copy to .env and fill real values. NEVER commit real secrets.
# Placeholders only — every value below is an example.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development            # development | staging | production
PORT=3000
APP_URL=                        # Public origin, e.g. https://www.aaswfoundation.com (used in emails, sitemap, certificates)

# Database (MySQL / TiDB)
DATABASE_URL=mysql://user:password@host:3306/aasw

# ── Secrets ────────────────────────────────────────────────────────────────
# Signs member portal JWT session cookies.
JWT_SECRET=change-me-strong-random-value

# Dedicated AES-256-GCM key for PII (PAN, government IDs). Preferred over the
# JWT fallback: once set, PII encryption no longer depends on session secrets.
# If unset, the app falls back to JWT_SECRET so existing rows stay decryptable.
PII_ENCRYPTION_KEY=

# ── Razorpay (live payments; leave unset to stay in safe demo mode) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Frontend checkout mode: "razorpay" enables the real gateway UI.
VITE_PAYMENT_GATEWAY_MODE=razorpay

# ── Transactional email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aaswfoundation06@gmail.com
SMTP_APP_PASSWORD=               # Gmail app password, never the account password

# ── Managed storage (Manus Forge presigned uploads) ─────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Platform OAuth (Foundation Admin / MIS sign-in) ─────────────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=                  # Manus openId that is auto-granted the admin role

# ── Optional: shared rate-limit store for multi-instance deployments ────────
# When set, sensitive-mutation rate limiting uses Redis instead of per-instance
# memory. Requires `pnpm add redis`. Unset = in-memory limiter (single instance).
REDIS_URL=

# Optional Umami analytics (leave empty locally; deployment sets real values)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
