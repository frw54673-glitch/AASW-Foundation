# Local development environment (generated for local preview)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database — local persistent embedded MySQL (see scripts/runPersistentDb.ts)
DATABASE_URL=mysql://root@127.0.0.1:3306/aasw

# Secrets (local dev only)
JWT_SECRET=local-dev-secret-aasw-foundation-preview-2026
PII_ENCRYPTION_KEY=

# Dev-only preview sign-in for Foundation Admin / MIS dashboards (local only)
ALLOW_DEV_PREVIEW_LOGIN=true

# Razorpay — left unset so checkout stays in safe demo mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_PAYMENT_GATEWAY_MODE=demo

# Transactional email — unset locally, emails are skipped/logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# Managed storage
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Platform OAuth (Foundation Admin / MIS sign-in) — not available locally;
# use scripts/seedDevAdmin.mjs for the local admin preview session.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

REDIS_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
